# Discord Bot Token (Wajib - Ambil dari https://discord.com/developers/applications)
DISCORD_TOKEN=YOUR_DISCORD_BOT_TOKEN_HERE

# Voice Channel ID untuk bot AFK standby 24/7 (Opsional)
AFK_VOICE_CHANNEL_ID=

# AI API Keys (Gratis) - Pilih salah satu atau isi keduanya
# Groq (Super Cepat): Ambil gratis di https://console.groq.com
GROQ_API_KEY=

# Google Gemini (Alternatif): Ambil gratis di https://aistudio.google.com
GEMINI_API_KEY=
